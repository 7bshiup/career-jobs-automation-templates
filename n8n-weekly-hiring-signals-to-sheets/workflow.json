    {
      "parameters": {
        "jsCode": "// One row per company: how many roles it published in the window, and where it is hiring.\nconst jobs = $input.all().map((item) => item.json).filter((j) => j && j.id);\nif (jobs.length === 0) return [];\n\nconst settings = $('Watchlist and filters').first().json;\nconst week = $now.toISODate();\nconst groups = new Map();\nfor (const j of jobs) {\n  const board = `${j.system}:${j.board}`;\n  if (!groups.has(board)) groups.set(board, { company: j.company || j.board, board, jobs: [] });\n  groups.get(board).jobs.push(j);\n}\nconst top = (values, n) => {\n  const counts = {};\n  for (const v of values) if (v) counts[v] = (counts[v] || 0) + 1;\n  return Object.entries(counts)\n    .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))\n    .slice(0, n)\n    .map(([k, c]) => `${k} (${c})`)\n    .join(', ');\n};\n\nreturn [...groups.values()]\n  .sort((a, b) => b.jobs.length - a.jobs.length || String(a.company).localeCompare(String(b.company)))\n  .map((g) => ({\n    json: {\n      week,\n      company: g.company,\n      board: g.board,\n      window_days: settings.postedWithinDays,\n      roles_posted: g.jobs.length,\n      top_departments: top(g.jobs.map((j) => j.department), 3),\n      top_countries: top(g.jobs.flatMap((j) => (j.countries && j.countries.length ? j.countries : [j.country])), 3),\n      remote_roles: g.jobs.filter((j) => j.remote).length,\n      roles_with_salary: g.jobs.filter((j) => j.salary_min != null || j.salary_max != null).length,\n      example_titles: g.jobs.slice(0, 3).map((j) => j.title).join(' | '),\n    },\n  }));\n"
      },
